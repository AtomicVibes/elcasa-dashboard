{
  "name": "elcasa-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEON_BRANCH": "production",
    "NEON_DATA_API_URL": "https://ep-misty-glitter-ab8rk0kc.apirest.eu-west-2.aws.neon.tech/neondb/rest/v1",
    "NEON_AUTH_JWKS_URL": "https://ep-misty-glitter-ab8rk0kc.neonauth.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
  }
}
