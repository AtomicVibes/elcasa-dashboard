{
  "name": "elcasa-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DATABASE_URL": "",
    "NEON_AUTH_BASE_URL": "",
    "NEON_AUTH_COOKIE_SECRET": "",
    "NEON_AUTH_URL": ""
  }
}
