# ─── Neon Auth ─────────────────────────────────────────────────────────────
# Get your Auth URL from Neon Console → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# ─── Supabase (database & storage only) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Stripe (billing endpoints — optional) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# uploads (object storage)
NEXT_PUBLIC_UPLOAD_PROVIDER=supabase-storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=project-images
